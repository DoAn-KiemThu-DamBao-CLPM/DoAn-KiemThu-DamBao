--- a/.htaccess
+++ b/.htaccess
@@ -0,0 +1,6 @@
+# Internal files must never be downloadable (Apache). Not interpreted by PHP's built-in server.
+Options -Indexes
+<FilesMatch "\.(sql|code-workspace|md|log|bak|ini|json|lock)$">
+    Require all denied
+</FilesMatch>
+RedirectMatch 403 ^/anyn/(sql|includes|config)/
--- a/sql/.htaccess
+++ b/sql/.htaccess
@@ -0,0 +1 @@
+Require all denied
